# GitHub App credentials. Prefer base64 for the multiline PEM:
#   base64 < app.private-key.pem | tr -d '\n'
APP_CLIENT_ID=Iv1.example
APP_PRIVATE_KEY_BASE64=base64-encoded-pem

# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# Z.AI Coding Plan credential used by Pi.
ZAI_API_KEY=replace-with-your-key

PI_MODELS=zai/glm-5.3:high
PR_AUTHOR=gregnazario
# GitHub App bot account slug; set when your App has a different name.
BOT_LOGIN=hedgehog-pr-bot
MAX_DIFF_CHARS=4000000

# Docker Compose host binding. Keep this on loopback when using a local TLS proxy.
BIND_ADDRESS=127.0.0.1
BIND_PORT=3000

# Review several authors (comma-separated). Defaults to PR_AUTHOR.
# PR_AUTHORS=gregnazario,collaborator

# Persist /ignore fingerprints so muted findings stay muted. Empty disables.
# REVIEW_MEMORY_PATH=/var/lib/hedgehog/ignores.json

# "json" wraps log lines in {time, level, message} objects.
# LOG_FORMAT=text

# Only for the optional compose "tls" profile (Caddy automatic HTTPS).
# DOMAIN=pr.example.com
