{
  "name": "hedgehog-pr-bot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "scan": "node scripts/review-prs.ts",
    "test": "node --test \"test/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=80 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "benchmark": "node benchmarks/run.ts",
    "benchmark:dry": "node benchmarks/run.ts --dry",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^24",
    "typescript": "^7.0.2"
  }
}
